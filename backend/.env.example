# Server
PORT=4000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Use Session pooler on IPv4 networks (recommended for local dev):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct connection (IPv6 only, for migrations on IPv6 networks):
# postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Security (optional in development, recommended in production)
# IP_HASH_SECRET=your-random-secret-min-16-chars

# CORS (optional — dashboard frontend origin)
# CORS_ORIGIN=http://localhost:3000
